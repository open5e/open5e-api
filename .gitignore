# Environment and configuration files
.env
local.env
*.local
.python-version

# SSL certificates
selfsigned.*

# OS-specific files
**/.DS_Store

# Python
__pycache__

# Database
db\.sqlite3
db.sqlite3-journal

# Django static files
staticfiles/

# Search index
server/whoosh_index/

# IDE and editor configurations
.vscode/
.idea/

# Test files
api/tests/approved_files/*.recieved.*

# Generated files
openapi-schema.yml

server/vector_index.pkl
server/build_info.json

# Temporary files for magic items update
temp_magic_items/
references_report.json
sources_report.json

# Open5e API Cache
# Uses .gitkeep to keep the folder structure in Git (for DO permissions) while
# ignoring the cached data itself.
api-cache/*
!api-cache/.gitkeep